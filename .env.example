# ── TradingAgents — Root .env.example ────────────────────────────────────────
# This file is the single source of truth for all docker compose environment
# variables.  Copy it to .env and fill in real values before running:
#
#   cp .env.example .env
#   docker compose up --build
#
# NEVER commit .env to version control.
# .env is already listed in .gitignore.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=TradingAgents Backend
APP_ENV=production
DEBUG=false

# ── Schema management ─────────────────────────────────────────────────────────
# false  → production mode: skip create_all, rely on Alembic migrations.
# true   → dev fallback: create_all at every startup (safe no-op for existing tables).
# Production first-deploy: docker compose exec backend uv run alembic upgrade head
ENABLE_CREATE_ALL=false

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase PostgreSQL — Transaction Pooler URL (port 6543).
# Format: postgresql+asyncpg://<user>:<password>@<host>:6543/<db>
# The backend uses NullPool + statement_cache_size=0 for PgBouncer compatibility.
DATABASE_URL=postgresql+asyncpg://user:password@host:6543/postgres

# ── Authentication ─────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Minimum 16 characters. 64 characters recommended for production.
SECRET_KEY=change-this-to-a-random-64-char-string

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Redis ─────────────────────────────────────────────────────────────────────
# docker compose: always redis://redis:6379 (the compose service name).
# Overridden in docker-compose.yml environment block, so this value is a
# fallback for local dev without Docker.
REDIS_URL=redis://redis:6379

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Leave blank if not using OpenAI
OPENAI_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# MUST be a JSON array.  Comma-separated strings will cause a startup crash.
#
# With Nginx reverse-proxy (VITE_API_BASE=/api/v1): browser uses same origin,
# so CORS is not enforced by browsers.  Still set a real value instead of "*".
#
# Correct:   CORS_ORIGINS=["https://yourdomain.com","http://localhost"]
# WRONG:     CORS_ORIGINS=https://yourdomain.com,http://localhost
CORS_ORIGINS=["http://localhost","https://yourdomain.com"]

# ── Free Mode Data Sources (v1.1.0-free-rc1) ─────────────────────────────────
# DATA_MODE=free uses only zero-cost data sources (BaoStock + AkShare).
# Set ENABLE_TUSHARE=false to suppress Tushare Pro API calls entirely.
#
# Stability caveat: BaoStock and AkShare are free, scraping-based sources.
# Field names and availability may differ from Tushare Pro.  AkShare interface
# names can change without notice — pin the version in pyproject.toml.
DATA_MODE=free
ENABLE_TUSHARE=false
ENABLE_BAOSTOCK=true
ENABLE_AKSHARE=true

# ── Report PDF + RAG ──────────────────────────────────────────────────────────
ENABLE_REPORT_PDF=true
ENABLE_REPORT_RAG=true

# Embedding provider for report RAG:
#   mock     — CI-safe, 0-cost, no real semantic search (link-test / CI only)
#   local    — sentence-transformers, requires pip install sentence-transformers
#              and ~100 MB model download on first use
#   disabled — no embedding; RAG will not function
#
# Production recommendation: REPORT_EMBEDDING_PROVIDER=local
# CI / smoke-test:           REPORT_EMBEDDING_PROVIDER=mock
REPORT_EMBEDDING_PROVIDER=local
REPORT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
REPORT_EMBEDDING_DIM=384

# ── Report Chat cache / rate limit / session memory ──────────────────────────
ENABLE_REPORT_CHAT_CACHE=true
REPORT_CHAT_CACHE_TTL_SECONDS=1800
REPORT_CHAT_CACHE_VERSION=v1
ENABLE_REPORT_CHAT_RATE_LIMIT=true
REPORT_CHAT_RATE_LIMIT_PER_MINUTE=10
REPORT_CHAT_RATE_LIMIT_PER_HOUR=100
ENABLE_REPORT_CHAT_MEMORY=true
REPORT_CHAT_MEMORY_TTL_SECONDS=3600
REPORT_CHAT_MEMORY_MAX_TURNS=5

# ── Analysis engine ───────────────────────────────────────────────────────────
# custom_coordinator (default, stable) | langgraph (gradual rollout)
DEFAULT_ANALYSIS_ENGINE=custom_coordinator
# memory (single-process) | redis (multi-worker, requires REDIS_URL)
ANALYSIS_RUN_REGISTRY=redis

# ── CompanyV2 Financial Evidence Fusion Phase 6T-K Stage 2 Manual Allowlist ─
# Stage 2 only: manual trigger, rollout_percent=0, auto_run=false.
COMPANY_V2_FINANCIAL_FUSION_ENABLED=true
COMPANY_V2_FINANCIAL_FUSION_ROLLOUT_PERCENT=0
COMPANY_V2_FINANCIAL_FUSION_SYMBOL_ALLOWLIST=601686,600519,300750,000725,000001
COMPANY_V2_FINANCIAL_FUSION_AUTO_RUN=false
COMPANY_V2_FINANCIAL_FUSION_STAGE3_AUTHORIZED=false
COMPANY_V2_FINANCIAL_FUSION_WORKER_MODE=shadow
COMPANY_V2_FINANCIAL_FUSION_WORKER_ENABLED=false
COMPANY_V2_RAG_REPOSITORY_BACKEND=database

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Copy these to frontend/.env.local or set in your build pipeline.
# VITE_USE_MOCK=false
# VITE_API_BASE_URL=https://your-api.example.com
# VITE_APP_ENV=production
# Company Tab rollout:
# - dev/staging: VITE_COMPANY_TAB_VERSION=v2
# - production default after Phase 6S cutover: VITE_COMPANY_TAB_VERSION=v2
# - production rollback: VITE_COMPANY_TAB_VERSION=legacy
# - URL override: company_v2=1 forces v2, company_v2=0 forces legacy
# Do not put secrets in VITE_ variables; Vite exposes them to the browser.
# VITE_COMPANY_TAB_VERSION=v2
