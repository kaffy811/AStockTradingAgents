-    direct_ip = request.client.host if request.client else "127.0.0.1"
-
-    if direct_ip not in trusted:
-        return direct_ip
-
-    # Direct connection is a trusted proxy — read X-Forwarded-For
-    xff = request.headers.get("X-Forwarded-For", "")
