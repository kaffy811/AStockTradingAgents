+import time
+from unittest.mock import AsyncMock
+import pytest
+from cryptography.hazmat.primitives.asymmetric import rsa
+from fastapi import HTTPException, Response
+from jose import jwt
+from app.services import google_identity as identity
+from app.routers import auth
+
+@pytest.fixture
+def issuer(monkeypatch):
+    key = rsa.generate_private_key(public_exponent=65537, key_size=2048)
+    monkeypatch.setattr(identity.settings, 'google_client_id', 'test-client')
+    monkeypatch.setattr(identity, '_keys', {'test': key.public_key()})
+    monkeypatch.setattr(identity, '_expires', time.monotonic() + 300)
+    claims = dict(sub='google-subject', email='person@gmail.com', email_verified=True,
+                  iss='https://accounts.google.com', aud='test-client', nonce='browser-nonce',
+                  iat=int(time.time()), exp=int(time.time()) + 300)
+    def issue(**changes):
+        return jwt.encode(claims | changes, key, algorithm='RS256', headers={'kid': 'test'})
+    return issue
+
+@pytest.mark.asyncio
+async def test_valid_google_identity(issuer):
+    assert (await identity.verify_google_token(issuer(), 'browser-nonce'))['sub'] == 'google-subject'
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('changes', [
+    {'aud': 'attacker-client'}, {'iss': 'https://attacker.invalid'},
+    {'nonce': 'other-browser'}, {'email_verified': False},
+    {'exp': int(time.time()) - 300}, {'email': ''},
+])
+async def test_reject_invalid_claims(issuer, changes):
+    with pytest.raises(HTTPException) as exc:
+        await identity.verify_google_token(issuer(**changes), 'browser-nonce')
+    assert exc.value.status_code == 401
+
+@pytest.mark.asyncio
+async def test_disabled_config(monkeypatch):
+    monkeypatch.setattr(auth.settings, 'google_client_id', '')
+    response = Response()
+    assert await auth.google_config(response) == {'enabled': False}
+    assert 'set-cookie' not in response.headers
+
+@pytest.mark.asyncio
+async def test_nonce_cookie(monkeypatch):
+    from app.core import database
+    redis = AsyncMock()
+    monkeypatch.setattr(database, 'get_redis', lambda: redis)
+    monkeypatch.setattr(auth.settings, 'google_client_id', 'test-client')
+    monkeypatch.setattr(auth.settings, 'app_env', 'production')
+    response = Response()
+    result = await auth.google_config(response)
+    assert result['enabled']
+    assert 'HttpOnly' in response.headers['set-cookie']
+    assert 'Secure' in response.headers['set-cookie']
+    assert response.headers['cache-control'] == 'no-store'
+    redis.set.assert_awaited_once_with('auth:google:nonce:' + result['nonce'], '1', ex=300)
+
+@pytest.mark.asyncio
+async def test_missing_cookie():
+    from starlette.requests import Request
+    request = Request({'type': 'http', 'headers': []})
+    db = AsyncMock()
+    with pytest.raises(HTTPException) as exc:
+        await auth.google_login(request, auth.GoogleLoginRequest(credential='fake'), db)
+    assert exc.value.status_code == 401
+    db.execute.assert_not_called()
+
+@pytest.mark.asyncio
+async def test_nonce_cannot_be_replayed(monkeypatch):
+    from app.core import database
+    from starlette.requests import Request
+    redis = AsyncMock()
+    redis.getdel.return_value = None
+    monkeypatch.setattr(database, 'get_redis', lambda: redis)
+    monkeypatch.setattr(identity, 'verify_google_token', AsyncMock(return_value={'sub': 'stable'}))
+    request = Request({'type': 'http', 'headers': [(b'cookie', b'ta_google_nonce=used')]})
+    db = AsyncMock()
+    with pytest.raises(HTTPException) as exc:
+        await auth.google_login(request, auth.GoogleLoginRequest(credential='fake'), db)
+    assert exc.value.status_code == 401
+    db.execute.assert_not_called()
+
+@pytest.mark.asyncio
+async def test_existing_email_requires_password_before_linking(monkeypatch):
+    from app.core import database
+    from starlette.requests import Request
+    from types import SimpleNamespace
+    from unittest.mock import MagicMock
+    redis = AsyncMock()
+    redis.getdel.return_value = '1'
+    monkeypatch.setattr(database, 'get_redis', lambda: redis)
+    monkeypatch.setattr(identity, 'verify_google_token', AsyncMock(return_value={
+        'sub': 'stable', 'email': 'person@gmail.com'}))
+    db = AsyncMock()
+    absent, existing = MagicMock(), MagicMock()
