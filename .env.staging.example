# ── TradingAgents — Staging Environment Template (Phase 6V-P1.24) ─────────────
#
# Copy to .env.staging.local and fill in real values.
# .env.staging.local is gitignored — do NOT commit it.
# This file (.env.staging.example) contains only placeholders — safe to commit.
#
# Used with:
#   docker compose \
#     -p tradingagents-p124-staging \
#     -f docker-compose.yml \
#     -f docker-compose.staging.yml \
#     --env-file .env.staging.local \
#     up -d --build

# ── Application ───────────────────────────────────────────────────────────────
APP_TITLE=TradingAgents (Staging)
APP_VERSION=0.0.0-staging-p124
APP_ENV=staging
DEBUG=false

# ── Security ─────────────────────────────────────────────────────────────────
# REQUIRED: Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Must be distinct from production SECRET_KEY. Never share with production.
SECRET_KEY=<STAGING_ONLY_RANDOM_64_HEX_CHARS>

# ── Database ──────────────────────────────────────────────────────────────────
# Use a dedicated staging database — NEVER point at production data.
# Options:
#   - Local Postgres: postgresql://postgres:password@host.docker.internal:5432/tradingagents_staging
#   - Separate Supabase project (recommended for isolation)
DATABASE_URL=<STAGING_ONLY_DATABASE_URL>

# ── Redis ────────────────────────────────────────────────────────────────────
# Overridden in compose to redis://redis:6379 (internal service).
# Only needed for direct (non-compose) local runs.
REDIS_URL=redis://redis:6379

# ── Pi Canary Staging Configuration ──────────────────────────────────────────
# These values configure the effective shadow rollout for Gate C verification.
# P1.25 Phase A (75% probe):
PI_CANARY_ROLLOUT_PERCENT=75
# Must be >= rollout_percent; default is 5.0 which blocks rollouts > 5%
PI_CANARY_MAX_ROLLOUT_PERCENT=100
PI_CANARY_CONFIG_VERSION=8
PI_CANARY_STABLE_BUCKET_SALT=pi_v1
# Valid values: proposed|approved|rejected|revoked|disabled  (NOT "authorized")
PI_CANARY_AUTHORIZATION_STATUS=approved
PI_CANARY_ENVIRONMENT=staging

# After 100% promotion (Phase B, if Gate C PASS):
# PI_CANARY_ROLLOUT_PERCENT=100
# PI_CANARY_CONFIG_VERSION=9

# Rollback target (if applied):
# PI_CANARY_ROLLOUT_PERCENT=75
# PI_CANARY_CONFIG_VERSION=10

# These must always remain false — shadow mode only
PI_CANARY_LIVE=false
PI_CANARY_PRODUCTION_ENABLED=false

# Snapshot path — written by lifespan startup, read by probe
PI_CANARY_SNAPSHOT_PATH=/tmp/tradingagents-runtime/pi_canary_snapshot.json

# Deployment identity — inject at build time or set here
DEPLOYMENT_SHA=<GIT_SHA_OF_STAGED_COMMIT>
DEPLOYMENT_MODE=containerized_staging

# ── Optional: External API Keys (staging-only or mock) ────────────────────────
# Use staging/sandbox API keys. Never use production keys in staging containers.
DEEPSEEK_API_KEY=<STAGING_ONLY_OR_LEAVE_BLANK_FOR_MOCK>
TUSHARE_TOKEN=<STAGING_ONLY_OR_LEAVE_BLANK>

# ── Canary Safe Defaults ─────────────────────────────────────────────────────
# These are already set to safe values by repository defaults.
# Override only if intentionally testing non-default behavior.
# PI_CANARY_ENVIRONMENT_KILL_SWITCH=false
# PI_CANARY_AGENT_KILL_SWITCH=false
# PI_CANARY_AUTO_ROLLBACK_ENABLED=true
